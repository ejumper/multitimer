# --- binaries / copyrighted source material (kept local only) ---
multitimer-spec/APK/
multitimer-spec/WORK/decompiled/
multitimer-spec/WORK/apk-manifest-check/
multitimer-spec/WORK/xapk-extract/
multitimer-spec/WORK/rejected/
# multitimer.net help-center content fetched verbatim — do NOT publish (public repo)
multitimer-spec/REFERENCE/

# --- local tooling ---
multitimer-spec/WORK/tools/

# --- planner v1 (new-app) build artifacts ---
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.plugin_symlinks/
# engine is a package: lockfile not committed (app's lockfile is)
new-app/packages/*/pubspec.lock
# licensed fonts + user sounds: local-only assets, never commit
new-app/apps/planner/assets/fonts/
new-app/apps/planner/assets/sounds/

# --- scratch ---
*.log

# tray icon placeholder (local-only, regenerable via new-app/scripts/gen_tray_icon.py)
new-app/apps/planner/assets/tray/
